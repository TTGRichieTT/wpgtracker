# Copy these into Replit "Secrets" (padlock icon). Do NOT put real values in GitHub.

# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
# Needed for Steam names, pictures, playtime and achievements.
STEAM_API_KEY=

# Long random password your Discord bot uses to send stats in (at least 16 characters).
INGEST_KEY=

# Replit sets this automatically when you add a PostgreSQL database.
# DATABASE_URL=

# Only for testing on your own PC. Must be off (or missing) on the live site.
# DEV_LOGIN=true

# Optional: your full site address if sign-in redirects go to the wrong place.
# PUBLIC_URL=https://your-app.replit.app
