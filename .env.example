# Copy these into Replit "Secrets" (padlock icon). Do NOT put real values in GitHub.

# Steam Web API key — get one at https://steamcommunity.com/dev/apikey
# Needed for Steam names, pictures, playtime and achievements.
STEAM_API_KEY=

# Long random password your Discord bot uses to send stats in (at least 16 characters).
INGEST_KEY=

# Replit sets this automatically when you add a PostgreSQL database.
# DATABASE_URL=

# Only for testing on your own PC. Must be off (or missing) on the live site.
# DEV_LOGIN=true

# Optional: your full site address if sign-in redirects go to the wrong place.
# PUBLIC_URL=https://your-app.replit.app

# Streams tab: spots when members go live. Each is optional; without one, streamers on that
# platform press "I'm live" in the app instead.
# Twitch: https://dev.twitch.tv/console/apps (Register Your Application, then New Secret)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# YouTube: Google Cloud console → enable "YouTube Data API v3" → Credentials → API key
# YOUTUBE_API_KEY=
# Kick: https://kick.com/settings/developer (create an app)
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=

# Optional long random password that encrypts members' stream keys (without it the app makes its own).
# Only set it before anyone saves a stream key, and never change it after.
# STREAM_KEY_SECRET=
